APP_ENV=development
OPENAI_API_KEY=
ORCHESTRATOR_MODEL=gpt-5.6-luna
SPECIALIST_MODEL=gpt-5.6-sol
DATABASE_PATH=data/consilium.db
ANALYTICS_DATABASE_PATH=data/analytics.db
ANALYTICS_ENABLED=1
ANALYTICS_RETENTION_DAYS=90
# Публичный числовой ID счётчика. Оставьте пустым, чтобы Яндекс Метрика не загружалась.
YANDEX_METRIKA_COUNTER_ID=
# Серверный API-ключ DaData. Если оставить пустым, ИНН вводится вручную.
DADATA_API_KEY=
DADATA_SUGGESTIONS_URL=https://suggestions.dadata.ru/suggestions/api/4_1/rs/suggest/party
DADATA_TIMEOUT_SECONDS=5
DADATA_SUGGESTIONS_CACHE_SECONDS=600
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
ONLINE_PAYMENTS_ENABLED=false
YOOKASSA_API_URL=https://api.yookassa.ru/v3
YOOKASSA_TIMEOUT_SECONDS=20
YOOKASSA_RECEIPTS_ENABLED=0
YOOKASSA_VAT_CODE=1
YOOKASSA_PAYMENT_MODE=full_prepayment
# Internal Bitrix Connector endpoint. Leave empty to disable payment notifications.
BITRIX_CONNECTOR_URL=
BITRIX_PAYMENT_SECRET=
BITRIX_METRICS_SECRET=
FUNNEL_MONITOR_POLL_SECONDS=30
BITRIX_CONNECTOR_TIMEOUT_SECONDS=5
EXAMINATION_SCHEDULE_ENABLED=false
EXAMINATION_SCHEDULE_API_URL=https://api.chelovekgrafik.ru/api
EXAMINATION_SCHEDULE_ACCESS_TOKEN=
EXAMINATION_SCHEDULE_REFRESH_TOKEN=
EXAMINATION_SCHEDULE_TOKEN_CACHE_PATH=data/examination-schedule-auth.json
EXAMINATION_SCHEDULE_SYNC_INTERVAL_SECONDS=86400
LOG_PATH=server-error.log
MAX_HISTORY_MESSAGES=30
MAX_HISTORY_CHARS=16000
HOST=127.0.0.1
PORT=8000
AUTO_OPEN_BROWSER=1
COOKIE_SECURE=0
PUBLIC_BASE_URL=http://127.0.0.1:8000
SPLITTER_EVENT_URL=
SPLITTER_EVENT_SECRET=
SPLITTER_EVENT_TIMEOUT_SECONDS=2
BOT_INTEGRATION_SECRET=
ADMIN_DASHBOARD_TOKEN=
AUTH_LINK_TTL_SECONDS=604800
AUTH_INTENT_TTL_SECONDS=604800
# Позже укажите ссылки на ботов. {token} будет заменён на одноразовый запрос привязки.
TELEGRAM_BOT_AUTH_URL=
MAX_BOT_AUTH_URL=
SESSION_TTL_DAYS=90
SESSION_COOKIE_NAME=consilium_session
