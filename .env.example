APP_ENV=development
OPENAI_API_KEY=
ORCHESTRATOR_MODEL=gpt-5.6-luna
SPECIALIST_MODEL=gpt-5.6-sol
DATABASE_PATH=data/consilium.db
ANALYTICS_DATABASE_PATH=data/analytics.db
ANALYTICS_ENABLED=1
ANALYTICS_RETENTION_DAYS=90
LOG_PATH=server-error.log
MAX_HISTORY_MESSAGES=30
HOST=127.0.0.1
PORT=8000
AUTO_OPEN_BROWSER=1
COOKIE_SECURE=0
PUBLIC_BASE_URL=http://127.0.0.1:8000
BOT_INTEGRATION_SECRET=
ADMIN_DASHBOARD_TOKEN=
AUTH_LINK_TTL_SECONDS=604800
AUTH_INTENT_TTL_SECONDS=604800
# Позже укажите ссылки на ботов. {token} будет заменён на одноразовый запрос привязки.
TELEGRAM_BOT_AUTH_URL=
MAX_BOT_AUTH_URL=
SESSION_TTL_DAYS=90
SESSION_COOKIE_NAME=consilium_session
