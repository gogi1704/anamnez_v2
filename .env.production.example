# Скопируйте файл в /etc/consilium/consilium.env и заполните OPENAI_API_KEY.
# Не добавляйте рабочий файл с секретом в Git и не отправляйте его в мессенджеры.
APP_ENV=production
OPENAI_API_KEY=
ORCHESTRATOR_MODEL=gpt-5.6-luna
SPECIALIST_MODEL=gpt-5.6-sol
DATABASE_PATH=/var/lib/consilium/consilium.db
LOG_PATH=/var/log/consilium/server-error.log
MAX_HISTORY_MESSAGES=30
HOST=127.0.0.1
PORT=8000
AUTO_OPEN_BROWSER=0
COOKIE_SECURE=1
PUBLIC_BASE_URL=https://consilium.example.ru
BOT_INTEGRATION_SECRET=replace-with-a-long-random-secret
AUTH_LINK_TTL_SECONDS=604800
SESSION_TTL_DAYS=90
SESSION_COOKIE_NAME=consilium_session
