# Скопируйте файл в /etc/consilium/consilium.env и заполните OPENAI_API_KEY.
# Не добавляйте рабочий файл с секретом в Git и не отправляйте его в мессенджеры.
APP_ENV=production
OPENAI_API_KEY=
ORCHESTRATOR_MODEL=gpt-5.6-luna
SPECIALIST_MODEL=gpt-5.6-sol
DATABASE_PATH=/var/lib/consilium/consilium.db
ANALYTICS_DATABASE_PATH=/var/lib/consilium/analytics.db
ANALYTICS_ENABLED=1
ANALYTICS_RETENTION_DAYS=90
YANDEX_METRIKA_COUNTER_ID=
# Серверный API-ключ DaData. Не добавляйте рабочий ключ в Git.
DADATA_API_KEY=
DADATA_SUGGESTIONS_URL=https://suggestions.dadata.ru/suggestions/api/4_1/rs/suggest/party
DADATA_TIMEOUT_SECONDS=5
DADATA_SUGGESTIONS_CACHE_SECONDS=600
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
ONLINE_PAYMENTS_ENABLED=false
YOOKASSA_API_URL=https://api.yookassa.ru/v3
YOOKASSA_TIMEOUT_SECONDS=20
YOOKASSA_RECEIPTS_ENABLED=0
YOOKASSA_VAT_CODE=1
YOOKASSA_PAYMENT_MODE=full_prepayment
LOG_PATH=/var/log/consilium/server-error.log
MAX_HISTORY_MESSAGES=30
MAX_HISTORY_CHARS=16000
HOST=127.0.0.1
PORT=8002
AUTO_OPEN_BROWSER=0
COOKIE_SECURE=1
PUBLIC_BASE_URL=https://consilium.example.ru
BOT_INTEGRATION_SECRET=replace-with-a-long-random-secret
ADMIN_DASHBOARD_TOKEN=replace-with-another-long-random-secret
AUTH_LINK_TTL_SECONDS=604800
AUTH_INTENT_TTL_SECONDS=604800
# Пример для Telegram: https://t.me/your_bot?start={token}
TELEGRAM_BOT_AUTH_URL=https://t.me/consillium_registration_bot?start={token}
MAX_BOT_AUTH_URL=
SESSION_TTL_DAYS=90
SESSION_COOKIE_NAME=consilium_session
